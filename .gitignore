# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved
# …except the app's, which is the release lockfile. `project.yml` declares its packages with
# `from:`, so a checkout without this file resolves to whatever is newest — a fresh worktree cut for
# build 28 silently took supabase-swift 2.50.0 → 2.55.1 and seven other upgrades, none of them
# tested. `xcodegen generate` leaves this file alone, so tracking it is safe.
!Genesyx.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.xcuserstate

# macOS
.DS_Store

# Secrets (never commit Supabase keys etc.)
Secrets.xcconfig
*.local.xcconfig

# Supabase CLI temp
supabase/.temp/

# Build junk
build_archive.log
run_archive.sh
_xcodeproj_backup_*/

# Build output / archives (never commit — regenerated by xcodebuild)
build/
build_sim/
build_sim_qa/
*.xcarchive/
build_export.log

# CodeGraph local index
.codegraph/

# Local agent scratch (logs, backups, worktrees)
.claude/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
